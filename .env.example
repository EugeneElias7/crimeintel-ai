# =============================================
# CrimeIntel AI — environment configuration
# Copy to .env and adjust. NEVER commit .env
# All values below are local-first defaults.
# =============================================

# --- General ---
APP_NAME=CrimeIntel AI
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (local-first) ---
# sqlite | catalyst (later)
DATABASE__PROVIDER=sqlite
DATABASE__URL=sqlite:///data/crimeintel.db

# --- Object storage (local-first) ---
# local | stratus (later)
STORAGE__PROVIDER=local
STORAGE__ROOT=storage
MAX_UPLOAD_MB=25

# --- Authentication (local-first) ---
# local | catalyst (later)
AUTH__PROVIDER=local
AUTH__JWT_SECRET=change-me-to-a-long-random-string
AUTH__ACCESS_TOKEN_MINUTES=15
AUTH__REFRESH_TOKEN_DAYS=7

# --- AI / CRIMA (local-first) ---
# local | quickml (later, evaluate)
AI__PROVIDER=local
AI__EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI__FAISS_INDEX=data/indexes/cases.index
AI__TOP_K=20
AI__ANSWER_TIMEOUT_SECONDS=10
# Optional local LLM adapter (leave empty to use template composer)
AI__LLM_URL=

# --- CORS (frontend dev origin) ---
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_CRIMA_PER_MINUTE=20