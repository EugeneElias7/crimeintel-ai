# Catalyst Configuration
CATALYST_PROJECT_ID=your_project_id_here
CATALYST_CLIENT_ID=your_client_id_here
CATALYST_CLIENT_SECRET=your_client_secret_here

# JWT Configuration
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRY_MINUTES=60

# CORS - comma-separated origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Upload Limits
MAX_UPLOAD_SIZE_MB=25

# Logging
LOG_LEVEL=INFO

# Data Store
DATA_STORE_TABLE_PREFIX=ci_

# LLM Provider Configuration
LLM_PROVIDER=nvidia

# NVIDIA API Configuration
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Ollama Configuration (for Qwen fallback)
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_HOST=http://127.0.0.1:11435

# Gemini Configuration (optional fallback)
GEMINI_API_KEY=
